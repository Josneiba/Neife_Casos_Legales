# Supabase (URL + clave pública; compatible con anon legacy)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin (UUIDs de auth.users separados por coma)
NEIFE_ADMIN_USER_IDS=

# Prisma — sustituye [YOUR-PASSWORD] por la contraseña de la BD en Supabase
# Pool (6543, pgbouncer) para la app
DATABASE_URL="postgresql://postgres.YOUR_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa para migraciones / introspection
DIRECT_URL="postgresql://postgres.YOUR_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Encriptación de documentos legales (AES-256-GCM)
# Generar con: node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('hex'))"
DOCUMENT_ENCRYPTION_KEY=64_caracteres_hex_aqui

# NUNCA commitear el .env.local real al repositorio
